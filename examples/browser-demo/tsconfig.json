{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    /*
     * `noUnusedLocals` / `noUnusedParameters` are deliberately OFF.
     * `paths` below puts the library's own source into this program, and
     * TypeScript has no way to apply compiler options per file -- so those two
     * flags would fail this demo's build on unused-variable style in the
     * library's in-progress code, which this repo does not own and must not
     * edit. Every flag that is on is a type-safety flag, not a style flag.
     */

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "types": ["node", "vite/client"],

    /*
     * The library's `dist/` is built concurrently and may not exist yet, so the
     * demo typechecks (and bundles, see vite.config.ts) against the library's
     * PUBLIC ENTRY POINT source. This is the single permitted exception to the
     * "public API only" rule -- `src/index.ts` *is* the public API. Nothing in
     * this demo may deepen this path into `tuninator/src/**` internals.
     */
    "paths": {
      "tuninator": ["../Tuninator/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
