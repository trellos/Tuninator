{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    /*
     * On, now that only this demo's own code is in the program. They used to be
     * off because a `paths` entry pulled the library's source in, and TypeScript
     * cannot apply compiler options per file.
     */
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "types": ["node", "vite/client"],

    /*
     * No `paths` mapping on purpose.
     *
     * `tuninator` and `tuninator/web` resolve through the package `exports` map
     * into `dist/*.d.ts`, exactly as they would for anyone who installed the
     * package -- so this typecheck also proves the published type surface is
     * usable, and that `exports` is wired correctly. It does mean the library
     * must be built first; CI orders the steps accordingly.
     *
     * `vite.config.ts` and `vitest.config.ts` alias to the library's SOURCE
     * instead, for live reload and so a stale `dist/` cannot make tests pass.
     * The two views disagreeing would itself be a build bug worth catching.
     */
  },
  "include": ["src", "vite.config.ts"]
}
